@page "/products"
@inject MyClient.Services.ProductApiService Api
@inject NavigationManager Nav

<PageTitle>Products</PageTitle>

<h2>Products</h2>
<a class="btn btn-primary mb-3" href="/products/create">+ New Product</a>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_products is null || _products.Count == 0)
{
    <p>No products found.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _products)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Name</td>
                    <td>@p.Price.ToString("C")</td>
                    <td>@p.Description</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary me-1" href="/products/edit/@p.Id">Edit</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(p.Id, p.Name)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_deleteId is not null)
{
    <!-- Inline confirm dialog -->
    <div class="modal d-block" style="background:rgba(0,0,0,0.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    Delete <strong>@_deleteName</strong>? This cannot be undone.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MyClient.Models.Product>? _products;
    private bool _loading = true;
    private string? _error;
    private int? _deleteId;
    private string? _deleteName;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _products = await Api.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load products: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _deleteId = id;
        _deleteName = name;
    }

    private void CancelDelete() => _deleteId = null;

    private async Task ExecuteDelete()
    {
        if (_deleteId is null) return;
        try
        {
            await Api.DeleteAsync(_deleteId.Value);
            _deleteId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Delete failed: {ex.Message}";
            _deleteId = null;
        }
    }
}
