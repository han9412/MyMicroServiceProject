<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceValidation>
    <!-- Treat source failures as warnings, not errors — handles SSL chain issues in some environments -->
    <add key="nuget.org" value="false" />
  </packageSourceValidation>
</configuration>
